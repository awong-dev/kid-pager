# 443 -> relay:8000; 80 -> 301 except the ACME challenge.

# Docker DNS re-resolved every 10 s so proxy_pass follows a recreated relay container.
resolver 127.0.0.11 valid=10s ipv6=off;
ssl_session_cache shared:WEB_SSL:10m;

# Lets nginx start before the first Let's Encrypt certificate exists.
map $ssl_server_name $pager_le_fullchain {
    default /data/certs/letsencrypt/live/pager/fullchain.pem;
}
map $ssl_server_name $pager_le_privkey {
    default /data/certs/letsencrypt/live/pager/privkey.pem;
}
map $ssl_server_name $pager_ext_fullchain {
    default /data/certs/external/fullchain.pem;
}
map $ssl_server_name $pager_ext_privkey {
    default /data/certs/external/privkey.pem;
}

# PAGER_PATH (a prefix such as /kid-pager, or empty for the root) is where the app is mounted. $pager_uri is the
# request with the prefix removed, exactly as the client encoded it and with its query string
# (a rewrite would decode %2F); it is empty for a request outside the prefix.
map $request_uri $pager_uri {
    default "";
    "~^${PAGER_PATH}(?<pager_rest>/.*)$" $pager_rest;
}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host${PAGER_WEB_PORT_SUFFIX}$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name _;

    include /etc/nginx/snippets/web-${TLS_MODE}.conf;
    include /etc/nginx/snippets/tls.conf;

    client_max_body_size 16m;
    # Redirects stay relative, so they survive a front proxy on another name or port.
    absolute_redirect off;

    # All no-ops when PAGER_PATH is empty, where nothing is outside the prefix: the bare prefix
    # gets its slash, the root leads to the app, and anything else outside is refused.
    rewrite ^${PAGER_PATH}$ ${PAGER_PATH}/ permanent;
    if ($pager_uri = "") {
        rewrite ^/$ ${PAGER_PATH}/ redirect;
        return 404;
    }

    # Scheduled-job routes answer only the compose network.
    location ${PAGER_PATH}/internal/ {
        return 404;
    }

    # SSE stream: no buffering, held open.
    location ${PAGER_PATH}/api/live {
        include /etc/nginx/snippets/proxy.conf;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location ${PAGER_PATH}/ {
        include /etc/nginx/snippets/proxy.conf;
    }
}
