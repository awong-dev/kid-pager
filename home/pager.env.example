# Copy to pager.env next to docker-compose.yml. Nothing here is secret: `init` generates every
# password and key into data/.

# The name (or public IP) the pager, phones and browsers use for this server.
PAGER_HOST=pager.example.org

# selfsigned: the stack's own CA signs the web certificate too (phones must
#   import data/certs/ca/ca.crt; no PWA install or push without it).
# letsencrypt: a public certificate for 443 from Let's Encrypt; needs port 80
#   forwarded and `docker compose --profile letsencrypt up -d`.
# The pager's port 8883 always uses the stack's own CA.
TLS_MODE=selfsigned
LETSENCRYPT_EMAIL=

# The path the app is served under: https://PAGER_HOST/kid-pager/ by default, so it can share a
# host with other sites (README.md, "Sharing the web ports with another web server").
# `/` serves it at the root.
# PAGER_PATH=/kid-pager
