# The relay holds no MQTT connection in the default mode: device traffic arrives via
# POST /webhooks/mqtt from the broker's rule engine (auth: WEBHOOK_KEY), and /down goes out
# through the broker's REST publish API at BROKER_API_URL.
BROKER_API_URL=http://emqx:18083/api/v5
BROKER_API_KEY=dev-broker-api-key
BROKER_API_SECRET=dev-broker-api-secret
WEBHOOK_KEY=dev-webhook-key

# `rest` (default, above) or `mqtt`: the relay holds one MQTT connection to Mosquitto as the
# dynamic-security admin client and manages device logins over it (home stack).
BROKER_MODE=rest
# BROKER_MQTT_HOST=mosquitto
# BROKER_MQTT_PORT=1883
# BROKER_MQTT_USERNAME=relay
# BROKER_MQTT_PASSWORD=

# Firestore is the document store; firebase-admin is emulator-aware via these two variables.
# Point them at the `firebase` compose service or at a local
# `firebase emulators:start --only firestore,auth --project demo-pager`.
FIRESTORE_EMULATOR_HOST=firebase:8080
FIREBASE_AUTH_EMULATOR_HOST=firebase:9099
GOOGLE_CLOUD_PROJECT=demo-pager

# Document store: "firestore" (default) or "sqlite", which serves the same client API from one
# SQLite file at SQLITE_PATH (home server).
DB_BACKEND=firestore
SQLITE_PATH=data/relay/pager.sqlite

# Sign-in: "firebase" (default) verifies Firebase ID tokens. "home" uses relay sessions: username
# + password or a passkey, the `pager_session` cookie (or `Authorization: Bearer <session>`),
# invite codes, and a first-run page while `users/` is empty. Passkeys use PUBLIC_BASE_URL's host
# as the relying party id. With DB_BACKEND=sqlite and AUTH_BACKEND=home nothing uses Firebase.
AUTH_BACKEND=firebase
# Reported on GET /api/me for the UI: "public" (default), "selfsigned" or "letsencrypt" (home).
TLS_MODE=public
# AUTH_BACKEND=home only: per-IP attempts on login, invite/redeem and passkey/login/* together,
# and per-username attempts on login, each per window.
RATE_LIMIT_AUTH_IP_LIMIT=30
RATE_LIMIT_AUTH_IP_WINDOW_S=600
RATE_LIMIT_AUTH_USER_LIMIT=10
RATE_LIMIT_AUTH_USER_WINDOW_S=600
# "none" (default, cloud: Cloud Scheduler calls /internal/tick and /internal/sweep) or "internal"
# (the relay runs both itself; /internal/* then also accepts X-Relay-Webhook-Key).
SCHEDULER_MODE=none

# DEV_MODE=1 enables POST /api/dev/token. Never set it in a real deployment.
DEV_MODE=1

# How long a loc_req stays 'sent'/coalescable before it is derived-expired (docs/PROTOCOL.md
# §13.4). 900 s is the protocol value; override only for tests. Never set in a real deployment.
LOC_REQ_TTL_S=900

# Cell-tower location fallback (docs/PROTOCOL.md §13.2), read from the environment on each call.
# CELL_GEO_PROVIDER: "none" (default: no lookup, nothing stored beyond devices/{d}.status.lastCell),
# "google" (Google Geolocation API) or "opencellid" (OpenCelliD). CELL_GEO_API_KEY is that
# provider's key; required for "google"/"opencellid". A lookup sends only the cell identity
# (mcc/mnc/tac/ci[/rsrp]) to the provider.
CELL_GEO_PROVIDER=none
CELL_GEO_API_KEY=

# The deployment's public HTTPS origin. It must match the URL configured in the Google Chat API
# console for `/webhooks/gchat`. Blank in dev: the Chat JWT check then always fails closed.
#
# It is also the base of the content-addressed `GET /ca/{sha256hex}.pem` pointer that a bootstrap
# bundle or a `cfg.ca` push hands a device. If a CA is configured (`BROKER_CA_PEM`) but this is
# blank, device create/rotate and the CA-push admin route refuse with a 500 rather than issue an
# unpinned bundle.
PUBLIC_BASE_URL=
# A file holding the broker CA PEM instead of BROKER_CA_PEM itself; BROKER_CA_PEM wins when both
# are set.
BROKER_CA_PEM_FILE=

# Google Chat backend (app/backends/gchat.py). GCHAT_AUDIENCE is the Chat app's project-number
# audience that the Google JWT `aud` claim must match; blank means POST /webhooks/gchat always
# fails closed. GCHAT_CERTS_URL overrides the cert-fetch endpoint for tests only. A Chat app needs
# a Google Workspace account (see relay/README.md).
GCHAT_AUDIENCE=
GCHAT_CERTS_URL=

# TASKS_MODE=inline (default) runs every retry synchronously in-process; the TASKS_* variables
# below are then unused. TASKS_MODE=cloud_tasks selects app/tasks.py's CloudTasksQueue, which is
# not usable end to end yet: do not set it in a real deployment.
TASKS_MODE=inline
TASKS_LOCATION=us-central1
TASKS_QUEUE=relay-retries
TASKS_SERVICE_ACCOUNT_EMAIL=

# Query page size, per collection, per iteration of the retention sweep. 500 is the built-in
# default; only tests lower it, to force the sweep loop to run more than once.
SWEEP_BATCH=500

# `/internal/tick` and `/internal/sweep` require a Google-signed OIDC ID token unless DEV_MODE is
# set (never set DEV_MODE=1 in a real deployment: it bypasses this).
#
# OIDC_AUDIENCE must be the Cloud Run service's own URL (e.g. https://pager-relay-xxxxx.a.run.app),
# not PUBLIC_BASE_URL: Cloud Scheduler calls the Cloud Run URL directly and mints the token's `aud`
# claim from it.
OIDC_AUDIENCE=
# Comma-separated allow-list of caller service-account emails. Blank means /internal/* always
# fails closed (401) once DEV_MODE is off.
OIDC_ALLOWED_EMAILS=

# Rate limits are Firestore-backed fixed-window counters (app/store/rate_limits.py), so they hold
# across Cloud Run instances. The defaults below are production bounds; relay/docker-compose.yml
# overrides them with much larger limits for local dev and e2e runs. Never copy those overrides
# into a real deployment.
#
# POST /api/me/backends (highest priority: each call can trigger a start_link).
RATE_LIMIT_BACKEND_CREATE_LIMIT=10
RATE_LIMIT_BACKEND_CREATE_WINDOW_S=3600
# /api/admin/* writes (coarser: already auth-gated).
RATE_LIMIT_ADMIN_WRITE_LIMIT=60
RATE_LIMIT_ADMIN_WRITE_WINDOW_S=60
# Per-IP, on /webhooks/gchat and /bridge/* (defense in depth: both are already token-gated).
RATE_LIMIT_WEBHOOK_IP_LIMIT=30
RATE_LIMIT_WEBHOOK_IP_WINDOW_S=60

# JSON-structured logs (Cloud Logging `severity` field). Standard Python level name; DEBUG is noisy.
LOG_LEVEL=INFO

# Selects the `webapp` backend's push client. "null" (default) makes push a no-op. "fcm" sends
# real pushes via `firebase_admin.messaging` with the Application Default Credentials that
# firebase-admin already uses. Never set "fcm" against the emulators: there is no FCM emulator,
# so every send would reach real Google infrastructure.
PUSH_BACKEND=null

# Standard Web Push (VAPID) to browsers, beside FCM. All unset = no Web Push
# (GET /api/push/vapid-public-key answers 503 and browsers keep FCM). WEBPUSH_SUBJECT defaults
# to PUBLIC_BASE_URL when that is https.
# WEBPUSH_VAPID_PRIVATE_KEY=
# WEBPUSH_VAPID_PUBLIC_KEY=
# WEBPUSH_SUBJECT=mailto:you@example.org

# The public OTA firmware bucket. FW_INDEX_URL is fw/index.json written by tools/fwpub.py;
# FW_BUCKET_BASE is the bucket's public base URL WITH a trailing slash (object paths from the
# index are appended to it). Either unset = every /api/admin OTA route answers 503.
# FW_INDEX_URL=https://storage.googleapis.com/<bucket>/fw/index.json
# FW_BUCKET_BASE=https://storage.googleapis.com/<bucket>/
# Where on-demand OTA deltas go. gcs (default): fw-cache/ in the bucket above. local:
# FW_CACHE_DIR on disk, served by the relay at PUBLIC_BASE_URL/fw-cache/...
# FW_CACHE=gcs
# FW_CACHE_DIR=data/fw-cache

# Bridge phones (a headless Android phone for SIM SMS, Google Voice and Google Chat) need no
# environment variables. Each phone's bearer token is minted at pairing and only its sha256 is
# stored (`bridges/{id}.tokenHash`); the optional FCM wake-up reuses PUSH_BACKEND above.

# Enrolls Soracom SIMs into the Beam group from the admin UI. A SAM user's auth key (keep it in
# Secret Manager). Both unset = the admin Soracom page shows setup instructions and the enroll
# routes answer 503.
SORACOM_AUTH_KEY_ID=
SORACOM_AUTH_KEY=
SORACOM_BEAM_GROUP=pager-beam
SORACOM_BEAM_DESTINATION=mqtts://broker.example.com:8883

# Messaging between linked families (relay to relay). Off until a super switches it on in
# Admin > Federation (server-wide, then per family); with the server off /fed/v1/info answers 404
# and every signed /fed/v1 route and federation admin route is refused. There is no environment
# switch. Each family has its own Ed25519 identity (kept in fedFamilies, server-only); the relay
# dials other relays at PUBLIC_BASE_URL's host and port.
# Outbound federation requests refuse loopback / link-local / multicast addresses always, and
# private ranges too on a cloud relay (AUTH_BACKEND=firebase).
# This relay's own TLS trust root for link invites, inline (FED_CA_PEM, a PEM with newlines) or as
# a file path (FED_CA_PEM_FILE). Unset: public CA, nothing in the invite. Under TLS_MODE=selfsigned
# it defaults to BROKER_CA_PEM.
# FED_CA_PEM=
# FED_CA_PEM_FILE=
# Seconds a message to a peer may wait before it fails `peer_offline` (default 86400, 24 h), and
# how long a peer with waiting messages may go without answering before it counts as down and the
# family gets a notice (default 900). Tests and the e2e stack shrink them; leave unset in
# production.
# FED_OFFLINE_AFTER_S=86400
# FED_DOWN_AFTER_S=900
# Public URL of the family web app; makes a link reauthorization invite (after a backup restore)
# a clickable URL on the other family's side. Optional.
# WEB_BASE_URL=

# The time zone (IANA name) that pager text such as "to Mom 5:21p: not delivered" is written in.
# There is no per-family zone.
# RELAY_TIMEZONE=America/Los_Angeles

# Seconds of silence (no authenticated request) before a bridge phone counts as offline and a
# notice goes out. Default 900 (three heartbeats). The e2e stack sets a small value.
# BRIDGE_OFFLINE_AFTER_S=900

# The largest family export file the import route accepts, in MiB (default 512).
# FAMILY_IMPORT_MAX_MB=512

# `python -m app.familyexport`: the file passphrase, read when --passphrase-file is not given
# (else the CLI prompts). Prefer the file or the prompt on a shared machine.
# KPFAM_PASSPHRASE=
